{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "p-dashboard-8",
  "description": "Empty and loading dashboard states",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "@coss/button",
    "@coss/card",
    "@coss/empty",
